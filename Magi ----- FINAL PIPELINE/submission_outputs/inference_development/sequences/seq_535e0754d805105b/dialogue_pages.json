      ],
      "speaker": null,
      "speaker_status": "conflicting_entities",
      "text_role": "SPOKEN",
      "text": "OTHER PEOPLE'S LIVES DIDN'T MEAN A THING TO THEM... ...BUT THEIR OWN, THEY HAD A PRETTY HIGH OPINION OF HARDLY THE SUICIDAL TYPE.",
