    },
    {
      "group_id": "PG2:T11",
      "box_ids": [
        "PG2:T11"
      ],
      "speaker": "E5",
      "speaker_status": "linked",
      "text_role": "SPOKEN",
      "text": "BUT OUR MR. WATTS... FOR SOME REASON, HELIKED THINGS COMPLICATED FOR HE FELT THE NEED TO SNEAK UP BEHIND HIS BODYGUARD... AND TAKE THE GOOD TIME AND TROUBLE TO CUT HIS THROAT FIRST.",
      "needs_review": true
    }
  ],
