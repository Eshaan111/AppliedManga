      "group_id": "PG2:T7",
      "box_ids": [
        "PG2:T7"
      ],
      "speaker": "E1",
      "speaker_status": "linked",
      "text_role": "SPOKEN",
      "text": "WHAT CAN WE REALLY SAY?",
