        "PG1:T12"
      ],
      "speaker": null,
      "speaker_status": "unassociated",
      "text_role": "SPOKEN",
      "text": "THE FIRST WAS ON JANUARY THE FIFTH, RICHARD BACH, AGED 45. LIVED ON EAST 152ND.",
      "needs_review": true
    }
  ],
  [
    {
      "group_id": "PG2:M1",
