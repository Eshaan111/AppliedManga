      "box_ids": [
        "PG2:T5"
      ],
      "speaker": "E1",
      "speaker_status": "linked",
      "text_role": "SPOKEN",
      "text": "AND NOW JERRY WATTS SLITS HIS OWN THROAT WITH A STRAIGHT RAZOR!",
      "needs_review": false
    },
    {
      "group_id": "PG2:T6",
      "box_ids": [
        "PG2:T6"
      ],
      "speaker": "E1",
      "speaker_status": "linked",
      "text_role": "SPOKEN",
