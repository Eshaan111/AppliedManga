    {
      "group_id": "PG3:T6",
      "box_ids": [
        "PG3:T6"
      ],
      "speaker": "E2",
      "speaker_status": "linked",
      "text_role": "SPOKEN",
      "text": "I SEE. SORRY TO BOTHER YOU AT A TIME LIKE THIS.",
