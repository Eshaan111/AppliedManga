**/models/
**/checkpoints/
**/checkpoint-*/
# Ignore run contents but allow selected small reports below.
**/training_runs/**
!**/training_runs/**/
**/runs/**
!**/runs/**/
**/runs_*/**
!**/runs_*/**/

# Input manga pages and reference labels; retain TaskData tools/manifests/sample submission.
/TaskData/*/images/
/TaskData/*/labels.jsonl

# Generated stage caches. Traverse subdirectories so final exports below remain uploadable.
**/cache*/**
!**/cache*/**/
**/*_cache/**
!**/*_cache/**/
!**/cache*/**/transcript.jsonl
!**/cache*/**/transcript_raw.jsonl
!**/cache*/**/predictions.jsonl
!**/cache*/**/predicted_labels.jsonl
!**/cache*/**/submission.jsonl
!**/cache*/**/score.json
!**/cache*/**/scores.json
!**/cache*/**/score_report.json
!**/cache*/**/score_results.json

# Small experiment reports referenced by the documentation.
# These exceptions do not include weights, tensors or per-box training predictions.
!**/runs/**/evaluation.json
!**/runs/**/evaluation_metrics.json
!**/runs/**/seed_summary.csv
!**/runs/**/per_seed_metrics.csv
!**/runs/**/previous_vs_joint_summary.csv
!**/runs/**/comparison.csv
!**/runs_*/**/evaluation_metrics.json
!**/runs_*/**/best_params.json
!**/training_runs/**/metrics.json

# Machine-local download metadata, generated scratch files and editor files.
**/.cache/
**/.paddlex/
**/.ipynb_checkpoints/
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.bak
*.swp
/temp.json
/venvtest.ipynb

# Keep final test predictions and score.py reports here, outside caches/training runs.
# No blanket *.json, *.jsonl, *.csv or outputs/ exclusion is intentional.
