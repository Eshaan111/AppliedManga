# Local Python environments and machine-specific secrets
.venv/
venv/
env/
godfather.venv/
.env
.env.*
!.env.example
!.env.template
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db
*.log
*.tmp

# Downloaded/trained weights and serialized feature data: host models separately.
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.gguf
