{
  "sequence_id": "seq_da71f7a842c91090",
  "texts": [
    {
      "id": "PG1:T1",
      "page": 1,
      "text": "WHA-?!"
    },
    {
      "id": "PG1:T2",
      "page": 1,
      "text": "Gojo sense!!"
    },
    {
      "id": "PG1:T3",
      "page": 1,
      "text": "What're you doing here?!"
    },
    {
      "id": "PG1:T4",
      "page": 1,
      "text": "Yo!"
    },
    {
      "id": "PG1:T5",
      "page": 1,
      "text": "I wasn't gonna come at first..."
    },
    {
      "id": "PG1:T6",
      "page": 1,
      "text": "???.."
    },
    {
      "id": "PG1:T7",
      "page": 1,
      "text": "Man, you're really messed up."
    },
    {
      "id": "PG1:T8",
      "page": 1,
      "text": "Click"
    },
    {
      "id": "PG1:T9",
      "page": 1,
      "text": "Should show all the second- years."
    },
    {
      "id": "PG1:T10",
      "page": 1,
      "text": "...but the higher- ups got involved after hearing that a special-grade cursed object went missing."
    },
    {
      "id": "PG1:T11",
      "page": 1,
      "text": "I agreed to come as long as they also gave me time to see the sights."
    },
    {
      "id": "PG1:T12",
      "page": 1,
      "text": "So..."
    },
    {
      "id": "PG1:T13",
      "page": 1,
      "text": "..."
    },
    {
      "id": "PG1:T14",
      "page": 1,
      "text": "did you find it?"
    },
    {
      "id": "PG1:T15",
      "page": 1,
      "text": "Um..."
    },
    {
      "id": "PG1:T16",
      "page": 1,
      "text": "Shr"
    },
    {
      "id": "PG1:T17",
      "page": 1,
      "text": "sorry ..."
    },
    {
      "id": "PG1:T18",
      "page": 1,
      "text": "I ate it."
    },
    {
      "id": "PG2:T1",
      "page": 2,
      "text": "For real?"
    },
    {
      "id": "PG2:T2",
      "page": 2,
      "text": "For real."
    },
    {
      "id": "PG2:T3",
      "page": 2,
      "text": "Hmm?"
    },
    {
      "id": "PG2:T4",
      "page": 2,
      "text": "Can he even see?"
    },
    {
      "id": "PG2:T5",
      "page": 2,
      "text": "ha ha! You're not kidding. They're combined."
    },
    {
      "id": "PG2:T6",
      "page": 2,
      "text": "That's hilarious."
    },
    {
      "id": "PG2:T7",
      "page": 2,
      "text": "How does your body feel?"
    },
    {
      "id": "PG2:T8",
      "page": 2,
      "text": "Okay..."
    },
    {
      "id": "PG2:T9",
      "page": 2,
      "text": "Can you switch to Sukuna?"
    },
    {
      "id": "PG2:T10",
      "page": 2,
      "text": "Sukuna?"
    },
    {
      "id": "PG2:T11",
      "page": 2,
      "text": "The cursed object you ate."
    },
    {
      "id": "PG2:T12",
      "page": 2,
      "text": "Oh, yeah. Probably..."
    },
    {
      "id": "PG3:T1",
      "page": 3,
      "text": "Ten seconds."
    },
    {
      "id": "PG3:T2",
      "page": 3,
      "text": "Guh Quh"
    },
    {
      "id": "PG3:T3",
      "page": 3,
      "text": "Take control again after ten seconds."
    },
    {
      "id": "PG3:T4",
      "page": 3,
      "text": "I dunno about this..."
    },
    {
      "id": "PG3:T5",
      "page": 3,
      "text": "Don't worry!"
    },
    {
      "id": "PG3:T6",
      "page": 3,
      "text": "Heh"
    },
    {
      "id": "PG3:T7",
      "page": 3,
      "text": "I'm the strong- EST Jujutsu son-cerer!"
    },
    {
      "id": "PG3:T8",
      "page": 3,
      "text": "megumi, hold on to this, will ya?"
    },
    {
      "id": "PG3:T9",
      "page": 3,
      "text": "Rust"
    },
    {
      "id": "PG3:T10",
      "page": 3,
      "text": "What's this?"
    },
    {
      "id": "PG3:T11",
      "page": 3,
      "text": "Kikufu Mochi."
    },
    {
      "id": "PG3:T12",
      "page": 3,
      "text": "KIKUSUIAN SHOP'S KIKUFUKU MOCHI A sendai City Specialty: Super delicious"
    },
    {
      "id": "PG3:T13",
      "page": 3,
      "text": "Kikusulian Shop's KikufuKuKuKuKu much"
    },
    {
      "id": "PG3:T14",
      "page": 3,
      "text": "Gojo's recommendation is the Edamame and Cream flavor."
    },
    {
      "id": "PG3:T15",
      "page": 3,
      "text": "I am"
    },
    {
      "id": "PG3:T16",
      "page": 3,
      "text": "this guy went to buy souvenirs!"
    },
    {
      "id": "PG3:T17",
      "page": 3,
      "text": "Even though people are dying over here."
    }
  ],
