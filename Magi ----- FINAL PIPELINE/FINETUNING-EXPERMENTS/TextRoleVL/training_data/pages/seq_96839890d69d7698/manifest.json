    {
      "id": "PG1:T1",
      "page": 1,
      "text": "MANIA SIREANLA don't mirror"
    },
    {
      "id": "PG1:T2",
      "page": 1,
      "text": "one's still alive."
    },
    {
      "id": "PG1:T3",
      "page": 1,
      "text": "Hmph..."
    },
    {
      "id": "PG1:T4",
      "page": 1,
      "text": "You're a strange one."
    },
    {
      "id": "PG1:T5",
      "page": 1,
      "text": "You don't smell like a devil or a human."
    },
    {
      "id": "PG2:T1",
      "page": 2,
      "text": "Did you do this?"
    },
    {
      "id": "PG2:T2",
      "page": 2,
      "text": "NANIAN: SIRLAY DO NOT NIRROR"
    },
    {
      "id": "PG2:T3",
      "page": 2,
      "text": "H-..."
    },
    {
      "id": "PG2:T4",
      "page": 2,
      "text": "Hold me..."
    },
    {
      "id": "PG3:T1",
      "page": 3,
      "text": "It's a human..."
    },
    {
      "id": "PG3:T2",
      "page": 3,
      "text": "Could he be taken over by a devil?"
    },
    {
      "id": "PG3:T3",
      "page": 3,
      "text": "No, you can tell take-overs by looking at their face."
    }
