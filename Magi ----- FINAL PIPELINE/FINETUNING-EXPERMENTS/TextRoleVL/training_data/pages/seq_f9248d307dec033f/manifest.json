{
  "sequence_id": "seq_f9248d307dec033f",
  "texts": [
    {
      "id": "PG1:T1",
      "page": 1,
      "text": "Hey, Kayo!"
    },
    {
      "id": "PG1:T2",
      "page": 1,
      "text": "Why are you taking so long to put away the oil? Hubby up!"
    },
    {
      "id": "PG1:T3",
      "page": 1,
      "text": "Yes, ma'am..."
    },
    {
      "id": "PG1:T4",
      "page": 1,
      "text": "I'll get it done right away."
    },
    {
      "id": "PG1:T5",
      "page": 1,
      "text": "My goodness."
    },
    {
      "id": "PG1:T6",
      "page": 1,
      "text": "beigh"
    },
    {
      "id": "PG2:T1",
      "page": 2,
      "text": "Oh, oops. A delivery?"
    },
    {
      "id": "PG2:T2",
      "page": 2,
      "text": "I didn't know we were expecting one."
    },
    {
      "id": "PG2:T3",
      "page": 2,
      "text": "No... I am an apothecary."
    },
    {
      "id": "PG2:T4",
      "page": 2,
      "text": "Oh, wait a minute!"
    },
    {
      "id": "PG2:T5",
      "page": 2,
      "text": "We don't have time for that sort of thing today!"
    },
    {
      "id": "PG2:T6",
      "page": 2,
      "text": "Because of the wedding?"
    },
    {
      "id": "PG3:T1",
      "page": 3,
      "text": "Yes, yes."
    },
    {
      "id": "PG3:T2",
      "page": 3,
      "text": " SFX: Do Don"
    },
    {
      "id": "PG3:T3",
      "page": 3,
      "text": "Lady Mao is being wed to Lord Shiono."
    }
