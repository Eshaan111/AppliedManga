{
  "schema_version": 1,
  "purpose": "Advisory whole-region lexicon for visual review. Entries are not automatic exclusion rules or verified annotations.",
  "policy": {
    "include": [
      "dialogue",
      "internal thoughts",
      "narration",
      "clear spoken screams, grunts, and other vocalisations",
      "punctuation-only speech/thought balloons, including ..., ?!, and !"
    ],
    "exclude": [
      "visual sound effects and their translated captions",
      "unclear tiny breath/reaction text on the art",
      "titles, logos, credits, page numbers, ads, and watermarks",
      "character intro labels",
      "editor and scanlator notes",
      "writing on signs, clothes, and objects",
      "text inside letters, diaries, phone messages, news pages, other documents, and interfaces"
    ],
    "reading_order": "Use intended visual order, usually right-to-left manga; follow panels and balloon connections when layout indicates otherwise.",
    "transcription": "Keep stutters, repeats, and meaningful punctuation; remove simple printed line wrapping.",
    "speakers": "Thoughts belong to the thinking character. Use the exact label NARRATION only for narrator text."
  },
  "matching_policy": "Whole-region normalized matches suggest visual review only. Never delete matching words from dialogue. No fuzzy matching. A speech/thought balloon or clear spoken vocalisation overrides a sound-effect hint; numbers can also be speech. Unmatched target status is not a gold exclusion label.",
